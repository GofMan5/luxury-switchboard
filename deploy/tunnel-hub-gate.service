[Unit]
Description=Shared model tunnel authorization gate
After=network.target

[Service]
Type=simple
User=tunnel-control
Group=tunnel-control
StateDirectory=tunnel-hub
StateDirectoryMode=0750
Environment=TUNNEL_HUB_STATE=/var/lib/tunnel-hub/tunnels.json
ExecStart=/usr/bin/python3 /usr/local/libexec/tunnel_hub.py serve --listen 172.20.0.1 --port 18080
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tunnel-hub
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
