# One distinct key per owner. `restrict` is intentional defense in depth.
restrict,command="/usr/bin/python3 /usr/local/libexec/tunnel_hub.py control --owner owner-1" ssh-ed25519 <OWNER_1_PUBLIC_KEY> owner-1
restrict,command="/usr/bin/python3 /usr/local/libexec/tunnel_hub.py control --owner owner-2" ssh-ed25519 <OWNER_2_PUBLIC_KEY> owner-2
