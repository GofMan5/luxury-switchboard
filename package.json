{
  "name": "provider-switchboard",
  "private": true,
  "version": "1.0.51",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "tauri dev",
    "build": "node scripts/build-release.mjs",
    "build:linux": "docker buildx build --file scripts/linux-build.Dockerfile --output type=local,dest=artifacts . && node scripts/build-release.mjs --checksums-only",
    "dev:prepare": "pnpm sidecar:build && pnpm --dir frontend dev",
    "build:prepare": "pnpm sidecar:build && pnpm --dir frontend build",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "check": "pnpm version:check && pnpm frontend:check && pnpm backend:check && cargo check --manifest-path src-tauri/Cargo.toml",
    "frontend:check": "pnpm --dir frontend check",
    "frontend:test": "pnpm --dir frontend test",
    "backend:check": "go -C backend test ./...",
    "backend:race": "go -C backend test -race ./..."
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
