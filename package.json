{
  "name": "provider-switchboard",
  "private": true,
  "version": "1.0.6",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:prepare": "pnpm sidecar:build && pnpm --dir frontend dev",
    "build:prepare": "pnpm sidecar:build && pnpm --dir frontend build",
    "sidecar:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "check": "pnpm frontend:check && pnpm backend:check && cargo check --manifest-path src-tauri/Cargo.toml",
    "frontend:check": "pnpm --dir frontend check",
    "frontend:test": "pnpm --dir frontend test",
    "backend:check": "go -C backend test ./...",
    "backend:race": "go -C backend test -race ./..."
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
